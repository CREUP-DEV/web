# Application
# Use a public canonical URL in production. In local development, localhost is still
# valid for the app runtime, but SEO/i18n metadata will fallback to https://www.creup.es.
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
OG_IMAGE_SECRET=replace-with-a-long-random-secret

# Admin access and OAuth
ADMIN_EMAILS=admin@example.com
ADMIN_EMAIL_DOMAIN=example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL
POSTGRES_USER=creup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creup
POSTGRES_PORT=5432
DATABASE_URL="postgresql://creup:change-me@localhost:5432/creup?schema=public"

# Local tooling
ADMINER_PORT=8088
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Google Calendar
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# External API and asset proxy
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_ASSET_PROXY_SECRET=replace-with-a-long-random-secret
EXTERNAL_ASSET_PROXY_ALLOWED_ORIGINS=https://api.example.com
EXTERNAL_ASSET_PROXY_TIMEOUT_MS=10000
EXTERNAL_ASSET_PROXY_IMAGE_MAX_BYTES=15728640
EXTERNAL_ASSET_PROXY_PDF_MAX_BYTES=41943040
EXTERNAL_API_CACHE_MAX_AGE_SECONDS=60
EXTERNAL_API_CACHE_STALE_SECONDS=300

# Mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=change-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_TO_EMAIL=info@example.com
SMTP_PRESS_EMAIL=press@example.com

# Analytics
NUXT_UMAMI_HOST=https://umami.example.com
NUXT_UMAMI_ID=00000000-0000-0000-0000-000000000000
