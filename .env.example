# Deployment target (required by deploy.sh)
VPS_HOST=dockeruser@your-vps-ip-or-hostname
REMOTE_DIR=/home/dockeruser/web
# Directory on VPS where docker compose is run. Defaults to REMOTE_DIR.
# Set this when docker-compose.yml lives outside the app directory (e.g. a shared compose at /home/dockeruser).
# COMPOSE_DIR=/home/dockeruser

# Optional GHCR login used by deploy.sh for local push
# If GHCR is private, run `docker login ghcr.io` once on the VPS.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional image overrides
# IMAGE_NAME=ghcr.io/creup-dev/web
# IMAGE_TAG=latest
# IMAGE=ghcr.io/creup-dev/web:latest

# Optional deploy settings
DOCKER_PLATFORM=linux/amd64
# Set true to run migrations during deploy before recreating app containers.
APPLY_MIGRATIONS_ON_DEPLOY=true
# Service names in docker-compose. Override when your compose uses different names.
# COMPOSE_APP_SERVICE=creup-web-app
# COMPOSE_POSTGRES_SERVICE=postgresql
APP_PORT=3000
APP_PUBLIC_UPLOADS_DIR=./data/public-uploads
APP_ADMIN_ASSETS_DIR=./data/admin-assets

# Application
# Runtime site origin for server-side URL generation.
NUXT_SITE_URL=http://localhost:3000
# Comma-separated list of trusted reverse-proxy CIDRs (IPv4 or IPv6).
# Only connections from these IPs will have X-Forwarded-For / X-Real-IP honored.
# Default (loopback only): 127.0.0.1/32,::1/128
# Production example (NGINX on same host + Docker bridge): 127.0.0.1/32,::1/128,172.17.0.0/16
# NUXT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Optional build-time origin override for deploy.sh / docker build.
# Use when local development stays on localhost but the production build
# must embed the public site URL.
# NUXT_DEPLOY_SITE_URL=https://creup.es
# Shared timezone used by app containers and Postgres runtime.
TZ=Europe/Madrid
# Master secret — used for Better Auth sessions and newsletter tokens.
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-long-random-secret


# Admin access and OAuth
# ADMIN_EMAILS: comma-separated list of emails that always have admin access, regardless of DB entries.
ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL
POSTGRES_USER=creup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creup
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# Database connection (used directly by migration scripts and DB pool, not through runtimeConfig).
DATABASE_URL="postgresql://creup:change-me@localhost:5432/creup?schema=public"

# Maximum number of connections in the pg connection pool.
# Set to match your Postgres plan's connection limit (default: 10).
DATABASE_MAX_CONNECTIONS=10

# Production with local postgres service:
# DATABASE_URL=postgresql://creup:change-me@postgres:5432/creup?schema=public
# NUXT_REDIS_URL=redis://:change-me-redis@redis:6379

# Production with external database:
# DATABASE_URL=postgresql://user:pass@db-host:5432/creup?schema=public

# Local tooling
ADMINER_PORT=8088
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Runtime configuration (NUXT_ prefix required for runtimeConfig override at server startup)

# Redis
NUXT_REDIS_URL=redis://localhost:6379

# Google Calendar
NUXT_GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
NUXT_GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# External API and asset proxy
# API URL can point to PHP app container, while asset URL can point to separate NGINX asset origin.
# Example split setup: `NUXT_EXTERNAL_API_BASE_URL=http://intranet:8080` and `NUXT_EXTERNAL_ASSET_BASE_URL=https://intranet.creup.es`
NUXT_EXTERNAL_API_BASE_URL=https://api.example.com
# Optional when assets are not served by the same origin as the API. Falls back to `NUXT_EXTERNAL_API_BASE_URL`.
NUXT_EXTERNAL_ASSET_BASE_URL=https://assets.example.com
# Comma-separated list. Keep internal asset origin first when available; add public aliases only if upstream still emits them.
NUXT_EXTERNAL_ASSET_PROXY_ALLOWED_ORIGINS=https://assets.example.com,https://api.example.com
NUXT_EXTERNAL_ASSET_PROXY_TIMEOUT_MS=10000
NUXT_EXTERNAL_ASSET_PROXY_IMAGE_MAX_BYTES=15728640
NUXT_EXTERNAL_ASSET_PROXY_PDF_MAX_BYTES=41943040
NUXT_EXTERNAL_API_CACHE_MAX_AGE_SECONDS=60
NUXT_EXTERNAL_API_CACHE_STALE_SECONDS=300

# Mail
NUXT_SMTP_HOST=127.0.0.1
NUXT_SMTP_PORT=1025
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=mailer@example.com
NUXT_SMTP_PASS=change-me
NUXT_SMTP_FROM_EMAIL=noreply@example.com
NUXT_SMTP_TO_EMAIL=info@example.com
NUXT_SMTP_PRESS_EMAIL=press@example.com

# Analytics
NUXT_UMAMI_HOST=https://umami.example.com
NUXT_UMAMI_ID=00000000-0000-0000-0000-000000000000

# Cloudflare Turnstile (public forms anti-spam)
NUXT_TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000AA
NUXT_PUBLIC_TURNSTILE_SITE_KEY=0x00000000000000000000AA
