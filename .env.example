# Deployment target (required by deploy.sh)
VPS_HOST=dockeruser@your-vps-ip-or-hostname
REMOTE_DIR=/home/dockeruser/web

# Optional GHCR login used by deploy.sh for local push
# If GHCR is private, run `docker login ghcr.io` once on the VPS.
GHCR_USERNAME=your-github-username
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional image overrides
# IMAGE_NAME=ghcr.io/CREUP-DEV/web
# IMAGE_TAG=latest
# IMAGE=ghcr.io/CREUP-DEV/web:latest

# Optional deploy settings
DOCKER_PLATFORM=linux/amd64
# Set true to run migrations as a deploy step (recommended for single-instance deploys)
APPLY_MIGRATIONS_ON_DEPLOY=true
# Set true to run migrations every time the app container starts
RUN_MIGRATIONS_ON_START=false
APP_PORT=3000
APP_PUBLIC_DIR=./data/public
APP_ADMIN_ASSETS_DIR=./data/admin-assets

# Application
# Use a public canonical URL in production.
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
OG_IMAGE_SECRET=replace-with-a-long-random-secret

# Admin access and OAuth
# ADMIN_EMAILS: comma-separated list of emails that always have admin access, regardless of DB entries.
ADMIN_EMAILS=admin@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostgreSQL
POSTGRES_USER=creup
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creup
POSTGRES_PORT=5432

# Local default:
DATABASE_URL="postgresql://creup:change-me@localhost:5432/creup?schema=public"

# Production with local postgres service:
# DATABASE_URL=postgresql://creup:change-me@postgres:5432/creup?schema=public

# Production with external database:
# DATABASE_URL=postgresql://user:pass@db-host:5432/creup?schema=public

# Local tooling
ADMINER_PORT=8088
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Google Calendar
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# External API and asset proxy
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_ASSET_PROXY_SECRET=replace-with-a-long-random-secret
EXTERNAL_ASSET_PROXY_ALLOWED_ORIGINS=https://api.example.com
EXTERNAL_ASSET_PROXY_TIMEOUT_MS=10000
EXTERNAL_ASSET_PROXY_IMAGE_MAX_BYTES=15728640
EXTERNAL_ASSET_PROXY_PDF_MAX_BYTES=41943040
EXTERNAL_API_CACHE_MAX_AGE_SECONDS=60
EXTERNAL_API_CACHE_STALE_SECONDS=300

# Mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=change-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_TO_EMAIL=info@example.com
SMTP_PRESS_EMAIL=press@example.com

# Analytics
NUXT_UMAMI_HOST=https://umami.example.com
NUXT_UMAMI_ID=00000000-0000-0000-0000-000000000000
